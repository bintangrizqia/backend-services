// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permission {
  READ
  DELETE
  UPDATE
  CREATE
}

enum Resource {
  PERSONNEL
  PROJECT
}

enum TypeProject {
  STRETCH_ACTIVITY
  TRAINING
  KPI_DIVISI
}

enum ActivityType {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Personnels {
  npp                  String                 @id
  unit_id              Int?
  position_id          Int?
  photo                String?
  eselon               Int                    @default(5)
  name                 String
  email                String?
  password             String
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  is_superuser         Boolean                @default(false)
  PersonnelGroups      PersonnelGroups[]
  PersonnelPermissions PersonnelPermissions[]
  ActivityLogs         ActivityLogs[]

  unit     Units?     @relation(fields: [unit_id], references: [id])
  position Positions? @relation(fields: [position_id], references: [id])
}

model Groups {
  id               String             @id @default(cuid())
  name             String             @unique
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  GroupPermissions GroupPermissions[]
  PersonnelGroups  PersonnelGroups[]
}

model GroupPermissions {
  id         String     @id @default(cuid())
  group_id   String
  resource   Resource
  permission Permission
  created_at DateTime   @default(now())

  group Groups @relation(fields: [group_id], references: [id])
}

model PersonnelGroups {
  id           String   @id @default(cuid())
  personnel_id String
  group_id     String
  created_at   DateTime @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [npp])
  group     Groups     @relation(fields: [group_id], references: [id])
}

model PersonnelPermissions {
  id           String     @id @default(cuid())
  personnel_id String
  resource     Resource
  permission   Permission
  created_at   DateTime   @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [npp])
}

model Programs {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  Projects    Projects[]
}

model Projects {
  id           String      @id @default(cuid())
  type_project TypeProject
  due_date     DateTime
  program_id   String
  target       String
  unit         String
  information  String?
  note         String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  program Programs @relation(fields: [program_id], references: [id])
}

model ActivityLogs {
  id            String       @id @default(cuid())
  personnel_id  String?
  url           String
  method        String
  description   String?
  ip_address    String?
  user_agent    String?
  payload       Json?
  status_code   Int?
  activity_type ActivityType @default(OTHER)
  created_at    DateTime     @default(now())

  // Optional relation to personnel (may be null for anonymous/unauthenticated access)
  personnel Personnels? @relation(fields: [personnel_id], references: [npp])
}

model Units {
  id         Int      @id
  parent_id  Int?
  name       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Update the self-relation with proper onDelete behavior
  unit      Units?  @relation("UnitHierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sub_units Units[] @relation("UnitHierarchy")

  Positions  Positions[]
  Personnels Personnels[]
}

model Positions {
  id         Int          @id
  unit_id    Int?
  name       String
  active     Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  unit       Units?       @relation(fields: [unit_id], references: [id])
  Personnels Personnels[]
}
