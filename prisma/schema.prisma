// Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permission {
  CAN_READ_PERSONNEL
  CAN_UPDATE_PERSONNEL
  CAN_DELETE_PERSONNEL
  CAN_CREATE_PERSONNEL

  CAN_CREATE_ORGANIZATION
  CAN_UPDATE_ORGANIZATION
  CAN_DELETE_ORGANIZATION
  CAN_READ_ORGANIZATION

  CAN_CREATE_PROJECT
  CAN_DELETE_PROJECT
  CAN_UPDATE_PROJECT
  CAN_ASSIGN_PROJECT
  CAN_REASSIGN_PROJECT

  CAN_CREATE_GROUP
  CAN_READ_GROUP
  CAN_UPDATE_GROUP
  CAN_DELETE_GROUP

  CAN_CREATE_PLAN_TYPE
  CAN_DELETE_PLAN_TYPE
  CAN_UPDATE_PLAN_TYPE
  CAN_READ_PLAN_TYPE


  CAN_CREATE_PROGRAM
  CAN_DELETE_PROGRAM
  CAN_UPDATE_PROGRAM
  CAN_READ_PROGRAM

  CAN_READ_PERMISSION

  CAN_CREATE_MANDATORY_TALENTA
  CAN_READ_MANDATORY_TALENTA
  CAN_UPDATE_MANDATORY_TALENTA
  CAN_DELETE_MANDATORY_TALENTA

  CAN_CREATE_ACCESS_PROJECT_TYPE
  CAN_READ_ACCESS_PROJECT_TYPE
  CAN_UPDATE_ACCESS_PROJECT_TYPE
  CAN_DELETE_ACCESS_PROJECT_TYPE

  CAN_CREATE_STATUS_REALISASI
  CAN_READ_STATUS_REALISASI
  CAN_UPDATE_STATUS_REALISASI
  CAN_DELETE_STATUS_REALISASI

}

enum Resource {
  PERSONNEL
  PROJECT
  ORGANIZATION
  GROUP
  PLAN_TYPES
  PERMISSION
  PROGRAM
  MANDATORY_TALENTA
  ACCESS_PROJECT_TYPE
  OVERVIEW_DIVISION
  STATUS_REALISASI
}

enum ActivityType {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Personnels {
  id                   String                 @id @default(cuid())
  npp                  String                 @unique
  unit_id              Int?
  position_id          Int?
  position_type        String?
  photo                String?
  eselon               Int?
  name                 String
  email                String?
  password             String
  active               Boolean                @default(true)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  is_superuser         Boolean                @default(false)
  PersonnelGroups      PersonnelGroups[]
  PersonnelPermissions PersonnelPermissions[]
  ActivityLogs         ActivityLogs[]

  unit     Units?     @relation(fields: [unit_id], references: [id])
  position Positions? @relation(fields: [position_id], references: [id])

  overview_divisions OverviewDivision[]

  performance_management_plan_transactions_as_target Performance_Management_Plan_Transactions[] @relation("PersonnelTargetRelation")
  performance_management_plan_transactions_as_from   Performance_Management_Plan_Transactions[] @relation("PersonnelFromRelation")

  @@index([name, email])
}

model Groups {
  id               String             @id @default(cuid())
  name             String             @unique
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  GroupPermissions GroupPermissions[]
  PersonnelGroups  PersonnelGroups[]
}

model GroupPermissions {
  id         String     @id @default(cuid())
  group_id   String
  resource   Resource
  permission Permission
  created_at DateTime   @default(now())

  group Groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

model PersonnelGroups {
  id           String   @id @default(cuid())
  personnel_id String
  group_id     String
  created_at   DateTime @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [id])
  group     Groups     @relation(fields: [group_id], references: [id])
}

model PersonnelPermissions {
  id           String     @id @default(cuid())
  personnel_id String
  resource     Resource
  permission   Permission
  created_at   DateTime   @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [id])
}

model ActivityLogs {
  id            String       @id @default(cuid())
  personnel_id  String?
  url           String
  method        String
  description   String?
  ip_address    String?
  user_agent    String?
  payload       Json?
  status_code   Int?
  activity_type ActivityType @default(OTHER)
  created_at    DateTime     @default(now())

  personnel Personnels? @relation(fields: [personnel_id], references: [id])
}

model MasterTypeUnits {
  id              Int      @id
  name            String
  level_type_unit Int
  active          Boolean  @default(true)
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  Units           Units[]
}

model Units {
  id            Int      @id
  parent_id     Int?
  type_unit_id  Int?
  name          String
  position_type String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  parent      Units?           @relation("UnitHierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: SetNull)
  sub_units Units[]          @relation("UnitHierarchy")
  type_unit MasterTypeUnits? @relation(fields: [type_unit_id], references: [id], onDelete: SetNull)

  Positions  Positions[]
  Personnels Personnels[]

  @@index([name, position_type])

}

model MasterTypePositions {
  id                  Int         @id
  name_s              String
  name_f              String
  eselon              Int
  level_type_position Int
  active              Boolean     @default(true)
  description         String?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  Positions           Positions[]

  @@index([name_f, name_s])
}

model Positions {
  id               Int          @id
  unit_id          Int?
  type_position_id Int?
  name             String
  active           Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  unit             Units?       @relation(fields: [unit_id], references: [id])
  Personnels       Personnels[]

  type_position MasterTypePositions? @relation(fields: [type_position_id], references: [id], onDelete: SetNull)

  performance_management_plan_transactions_as_target Performance_Management_Plan_Transactions[] @relation("PositionTargetRelation")
  performance_management_plan_transactions_as_from   Performance_Management_Plan_Transactions[] @relation("PositionFromRelation")

  @@index([name, active])
}

// Performance Management models

model Performance_Management_Plan_Types {
  id                                   String                                 @id @default(cuid())
  name                                 String                                 @unique
  description                          String?
  created_at                           DateTime                               @default(now())
  updated_at                           DateTime                               @updatedAt
  Performance_Management_Plan_Projects Performance_Management_Plan_Projects[]
   

  @@index([name])

  MandatoryTalenta                    MandatoryTalenta[] 
  accessProjectTypes AccessProjectType[]

}

model Performance_Management_Plan_Projects {
  id                                     String  @id @default(cuid())
  key                                    String
  name                                   String
  target                                 String
  unit                                   String
  project_status                         String
  approval_status                        Int
  description                            String?
  created_by                             String?
  year                                   Int
  performance_management_plan_type_id    String
  owner                                  String
  performance_management_plan_program_id String
  note                                   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  performance_management_plan_type    Performance_Management_Plan_Types   @relation(fields: [performance_management_plan_type_id], references: [id], map: "fk_plan_type")
  performance_management_plan_program Performance_Management_Plan_Program @relation(fields: [performance_management_plan_program_id], references: [id], map: "fk_plan_program")

  performance_management_plan_transaction           Performance_Management_Plan_Transactions[] @relation("PerformanceManagementProjectRel")
  performance_management_plan_transaction_as_parent Performance_Management_Plan_Transactions[] @relation("PerformanceManagementProjectParentRel")

  accessProjectTypes AccessProjectType[]

  overview_divisions OverviewDivision[]


}

model Performance_Management_Plan_Program {
  id           String   @id @default(cuid())
  name         String
  description  String?
  year         Int
  status       String
  created_by   String
  program_code String
  active       Boolean @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  performance_management_plan_projects Performance_Management_Plan_Projects[]
  @@index([name, year, status, program_code, active])

  overview_divisions OverviewDivision[]

}

model Performance_Management_Plan_Transactions {
  id                                                      String   @id @default(cuid())
  personnel_target_id                                     String
  position_target_id                                      Int
  performance_management_project_id                       String
  performance_management_project_parent_id                String
  approved_status                                         Int
  realization                                             String
  realization_status                                      Int
  description                                             String?
  personnel_from_id                                       String
  position_from_id                                        Int
  due_date                                                DateTime
  created_by                                              String
  year                                                    Int
  activity_project                                        String
  activity_target                                         String
  activity_unit                                           String
  boss_who_creating_an_activity                           String
  project_active_status                                   String
  realization_active_status                               String
  performance_management_plan_program_id                  String
  realization_boss_who_create_an_activity_percentage      Int
  realization_self_percentage                             Int
  note                                                    String?
  created_at                                              DateTime @default(now())
  updated_at                                              DateTime @updatedAt

  personnel_target Personnels @relation("PersonnelTargetRelation", fields: [personnel_target_id], references: [id], map: "fk_personnel_target")
  personnel_from   Personnels @relation("PersonnelFromRelation", fields: [personnel_from_id], references: [id], map: "fk_personnel_from")

  position_target Positions @relation("PositionTargetRelation", fields: [position_target_id], references: [id], map: "fk_position_target")
  position_from   Positions @relation("PositionFromRelation", fields: [position_from_id], references: [id], map: "fk_position_from")

  performance_management_project        Performance_Management_Plan_Projects @relation("PerformanceManagementProjectRel", fields: [performance_management_project_id], references: [id], map: "fk_pmp_project")
  performance_management_project_parent Performance_Management_Plan_Projects @relation("PerformanceManagementProjectParentRel", fields: [performance_management_project_parent_id], references: [id], map: "fk_pmp_project_parent")

  overview_division OverviewDivision[] @relation("OverviewDivisionToTransaction")
}

model MandatoryTalenta {
  id          String   @id @default(uuid())
  project     String
  information String?
  key         String
  plan_type   Performance_Management_Plan_Types @relation(fields: [key], references: [id])
  year        Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
} 

model AccessProjectType {
  id            String   @id @default(cuid())
  keys          String
  unit          String // BUKAN relasi
  type          String
  project_name  String
  information   String
  target        Int
  year          Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project       Performance_Management_Plan_Projects @relation(fields: [keys], references: [id])
  typeRel       Performance_Management_Plan_Types   @relation(fields: [type], references: [id])

  @@map("access_project_type")
}

model OverviewDivision {
  id              String   @id @default(cuid())
  personnel_id    String
  program_id      String
  project_id      String
  transaction_id  String? // Optional: karena transaksi bisa lebih dari satu
  status_id       Int?
  due_date        DateTime?
  information     String?
  explanation     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  personnel   Personnels                          @relation(fields: [personnel_id], references: [id])
  program     Performance_Management_Plan_Program @relation(fields: [program_id], references: [id])
  project     Performance_Management_Plan_Projects @relation(fields: [project_id], references: [id])
  transaction Performance_Management_Plan_Transactions? @relation("OverviewDivisionToTransaction", fields: [transaction_id], references: [id])
  status          StatusRealisasi?                    @relation(fields: [status_id], references: [id])
}

model StatusRealisasi {
  id                     Int      @id @default(autoincrement())
  nama_status_realisasi String
  kode_warna_realisasi  String
  keterangan            String
  created_by            String
  created_date          DateTime @default(now())

  overviewDivisions     OverviewDivision[]
}




 


