// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permission {
  CAN_READ_PERSONNEL
  CAN_UPDATE_PERSONNEL
  CAN_DELETE_PERSONNEL
  CAN_CREATE_PERSONNEL

  CAN_CREATE_ORGANIZATION
  CAN_UPDATE_ORGANIZATION
  CAN_DELETE_ORGANIZATION
  CAN_READ_ORGANIZATION

  CAN_CREATE_PROJECT
  CAN_DELETE_PROJECT
  CAN_UPDATE_PROJECT
  CAN_ASSIGN_PROJECT
  CAN_REASSIGN_PROJECT

  CAN_CREATE_GROUP
  CAN_READ_GROUP
  CAN_UPDATE_GROUP
  CAN_DELETE_GROUP
}

enum Resource {
  PERSONNEL
  PROJECT
  ORGANIZATION
  GROUP
}

enum ActivityType {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Personnels {
  id                   String                 @id @default(cuid())
  npp                  String                 @unique
  unit_id              Int?
  position_id          Int?
  position_type        String?
  photo                String?
  eselon               Int?
  name                 String
  email                String?
  password             String
  active               Boolean                @default(true)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  is_superuser         Boolean                @default(false)
  PersonnelGroups      PersonnelGroups[]
  PersonnelPermissions PersonnelPermissions[]
  ActivityLogs         ActivityLogs[]

  unit     Units?     @relation(fields: [unit_id], references: [id])
  position Positions? @relation(fields: [position_id], references: [id])
}

model Groups {
  id               String             @id @default(cuid())
  name             String             @unique
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  GroupPermissions GroupPermissions[]
  PersonnelGroups  PersonnelGroups[]
}

model GroupPermissions {
  id         String     @id @default(cuid())
  group_id   String
  resource   Resource
  permission Permission
  created_at DateTime   @default(now())

  group Groups @relation(fields: [group_id], references: [id])
}

model PersonnelGroups {
  id           String   @id @default(cuid())
  personnel_id String
  group_id     String
  created_at   DateTime @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [id])
  group     Groups     @relation(fields: [group_id], references: [id])
}

model PersonnelPermissions {
  id           String     @id @default(cuid())
  personnel_id String
  resource     Resource
  permission   Permission
  created_at   DateTime   @default(now())

  personnel Personnels @relation(fields: [personnel_id], references: [id])
}

model ActivityLogs {
  id            String       @id @default(cuid())
  personnel_id  String?
  url           String
  method        String
  description   String?
  ip_address    String?
  user_agent    String?
  payload       Json?
  status_code   Int?
  activity_type ActivityType @default(OTHER)
  created_at    DateTime     @default(now())

  // Optional relation to personnel (may be null for anonymous/unauthenticated access)
  personnel Personnels? @relation(fields: [personnel_id], references: [id])
}

model MasterTypeUnits {
  id              Int      @id
  name            String
  level_type_unit Int
  active          Boolean  @default(true)
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  Units           Units[]
}

model Units {
  id            Int      @id
  parent_id     Int?
  type_unit_id  Int?
  name          String
  position_type String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Update the self-relation with proper onDelete behavior
  unit      Units?           @relation("UnitHierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: SetNull)
  sub_units Units[]          @relation("UnitHierarchy")
  type_unit MasterTypeUnits? @relation(fields: [type_unit_id], references: [id], onDelete: SetNull)

  Positions  Positions[]
  Personnels Personnels[]
}

model MasterTypePositions {
  id                  Int         @id
  name_s              String
  name_f              String
  eselon              Int
  level_type_position Int
  active              Boolean     @default(true)
  description         String?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  Positions           Positions[]
}

model Positions {
  id               Int          @id
  unit_id          Int?
  type_position_id Int?
  name             String
  active           Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  unit             Units?       @relation(fields: [unit_id], references: [id])
  Personnels       Personnels[]

  type_position MasterTypePositions? @relation(fields: [type_position_id], references: [id], onDelete: SetNull)
}

model Performance_Managelement_Plan_Types {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
